syntax = "v1"

type RegisterReq {
	Email    string `json:"email"`
	Password string `json:"password"`
	Nickname string `json:"nickname"`
}

type LoginReq {
	Email    string `json:"email"`
	Password string `json:"password"`
}

type LoginResp {
	AccessToken  string `json:"accessToken"`
	AccessExpire int64  `json:"accessExpire"`
	RefreshToken string `json:"refreshToken"`
	RefreshExpire int64 `json:"refreshExpire"`
}

type EmptyResp {}

type UserProfile {
	Id        int64  `json:"id"`
	Email     string `json:"email"`
	Nickname  string `json:"nickname"`
	Bio       string `json:"bio"`
	Avatar    string `json:"avatar"`
	CreatedAt string `json:"createdAt"`
}

type UserResp {
	User UserProfile `json:"user"`
}

type GetUserReq {
	UserId int64 `path:"userId"`
}

type ListUsersReq {
	Page     int64 `form:"page,optional"`
	PageSize int64 `form:"pageSize,optional"`
}

type UpdateProfileReq {
	Nickname *string `json:"nickname,optional"`
	Bio      *string `json:"bio,optional"`
	Avatar   *string `json:"avatar,optional"`
}

type ChangePasswordReq {
	OldPassword string `json:"oldPassword"`
	NewPassword string `json:"newPassword"`
}

type RefreshTokenReq {
	RefreshToken string `json:"refreshToken"`
}

type UserListResp {
	Items    []UserProfile `json:"items"`
	Page     int64         `json:"page"`
	PageSize int64         `json:"pageSize"`
	Total    int64         `json:"total"`
}

@server(
	group: auth
	prefix: /api/v1
)
service usercenter-api {
	@handler Register
	post /auth/register (RegisterReq) returns (UserResp)

	@handler Login
	post /auth/login (LoginReq) returns (LoginResp)
}

@server(
	jwt: Auth
	middleware: Audit
	group: auth
	prefix: /api/v1
)
service usercenter-api {
	@handler Refresh
	post /auth/refresh (RefreshTokenReq) returns (LoginResp)

	@handler Logout
	post /auth/logout returns (EmptyResp)
}

@server(
	jwt: Auth
	middleware: Audit
	group: user
	prefix: /api/v1
)
service usercenter-api {
	@handler GetMe
	get /users/me returns (UserResp)

	@handler GetUser
	get /users/:userId (GetUserReq) returns (UserResp)

	@handler ListUsers
	get /users (ListUsersReq) returns (UserListResp)

	@handler UpdateProfile
	patch /users/me (UpdateProfileReq) returns (UserResp)

	@handler ChangePassword
	patch /users/me/password (ChangePasswordReq) returns (EmptyResp)

	@handler DeleteProfile
	delete /users/me returns (EmptyResp)
}
